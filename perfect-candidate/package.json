{
  "name": "perfect-candidate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @show/app dev",
    "build": "pnpm --filter @show/app build",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "release": "node tools/release.mjs",
    "media": "python3 tools/media/prepare.py"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
